{"worlds": [{"name": "JUNGLA FLOTANTE", "sub": "Resortes y lianas", "c": "#7dea5a", "tiles": "T_jungle", "music": "w0", "bg": 0, "weather": "leaves", "critter": "bird", "g": ["opossum", "opossum", "frog"], "a": ["eagle"], "spk": "spk_jungle", "mplat": "p_platform-long", "pool": ["spring", "bouncefield", "pits", "movepits", "mover", "elevator", "climb"], "sig": ["spring", "pits", "spikes"], "deco": [["p_tree", 1], ["p_bush", 3], ["p_rock", 2], ["p_shrooms", 2], ["d_grass1", 4], ["d_grass2", 4], ["d_plant1", 2], ["d_plant2", 2]], "boss": {"type": 0, "name": "GRAN SAPO ANCESTRAL", "hint": "¡Salta las ondas de choque!"}, "lore": "El Reloj del Origen se ha roto y sus fragmentos han desgarrado la realidad. Kael, el último Guardián del Tiempo, despierta en la Jungla Flotante."}, {"name": "VELMORA, CIUDAD MALDITA", "sub": "Catedrales y dimensiones", "c": "#d0506a", "tiles": "T_cemetery", "music": "w1", "bg": 1, "weather": "rain", "critter": "crow", "g": ["nb_hellbeast", "nb_hooded"], "a": ["nb_bat"], "spk": "spk_cem", "mplat": "gv_mplat", "pool": ["shiftgap", "shiftwall", "shiftpit", "lasers", "gauntlet", "crumble", "dashgap"], "sig": ["shiftpit", "shiftwall", "chase"], "deco": [["gv_statue", 1], ["gv_stone-1", 3], ["gv_pillar-broken", 2], ["gv_tree-1", 1]], "boss": {"type": 1, "name": "GÁRGOLA DE LA CATEDRAL", "hint": "Esquiva sus rayos malditos y golpéala cuando caiga"}, "lore": "Un fragmento cayó sobre Velmora, la ciudad de las mil campanas, y la maldijo para siempre. Aquí despiertas el poder del SHIFT: cambia de dimensión para hacer aparecer y desaparecer plataformas."}, {"name": "CALDERO VOLCÁNICO", "sub": "Lava y fuego", "c": "#ff8f3a", "tiles": "T_volcano", "music": "w2", "bg": 2, "weather": "embers", "critter": null, "lavaPits": true, "g": ["firerat", "worm"], "a": ["nb_fireskull"], "spk": "spk_inf", "mplat": "p_platform_v", "pool": ["lavapit", "firejets", "crumblechain", "crumble", "climb", "dashgap", "gauntlet"], "sig": ["crumblechain", "lavapit", "firejets"], "deco": [["p_rock_v", 3], ["p_skulls", 3], ["p_spike-skull", 2], ["d_torch", 2]], "boss": {"type": 2, "name": "HECHICERO DE MAGMA", "hint": "Golpea las 3 palancas para romper su escudo"}, "lore": "El calor del núcleo funde el tiempo mismo. La lava sube y el Hechicero de Magma custodia el tercer fragmento."}, {"name": "BOSQUE DEL CREPÚSCULO", "sub": "Vientos y hongos", "c": "#ffb070", "tiles": "T_dusk", "music": "w3", "bg": 3, "weather": "fireflies", "critter": "bird", "g": ["goblin", "mushroom"], "a": ["eye"], "spk": "spk_jungle", "mplat": "p_platform-long", "pool": ["updraft", "gust", "windpit", "bouncefield", "pits", "climb", "spring"], "sig": ["windpit", "updraft", "gust"], "deco": [["p_tree", 2], ["p_bush", 3], ["p_shrooms", 4], ["p_rock", 2], ["d_plant1", 2]], "boss": {"type": 3, "name": "OJO ABISAL", "hint": "Esquiva sus embestidas y golpéalo al bajar"}, "lore": "En el bosque donde el sol nunca termina de ponerse, los vientos del tiempo soplan con fuerza. Algo te observa desde las alturas."}, {"name": "CEMENTERIO MALDITO", "sub": "Espectros y tumbas", "c": "#c070ff", "tiles": "T_cemetery", "music": "w4", "bg": 4, "weather": "fog", "critter": "crow", "g": ["gskel", "hound"], "a": ["ghost"], "spk": "spk_cem", "mplat": "gv_mplat", "pool": ["graves", "ghosts", "gauntlet", "shiftwall", "pits", "climb", "crumble"], "sig": ["gauntlet", "ghosts", "graves"], "deco": [["gv_statue", 1], ["gv_stone-1", 3], ["gv_stone-2", 3], ["gv_stone-4", 2], ["gv_bush-small", 2], ["gv_tree-1", 1], ["gv_pillar-broken", 1]], "boss": {"type": 4, "name": "CABALLERO ESQUELETO", "hint": "Su escudo bloquea de frente: atácalo por la espalda"}, "lore": "Los muertos se levantan cuando el tiempo se detiene. Los espectros solo son tangibles en la otra dimensión: usa el SHIFT para golpearlos."}, {"name": "CRIPTA HELADA", "sub": "Hielo y estalactitas", "c": "#9fe3ff", "tiles": "T_ice", "music": "w5", "bg": 5, "weather": "snow", "critter": "crow", "ice": true, "g": ["nb_reaper", "icehound"], "a": ["nb_eghost"], "spk": "spk_ice", "mplat": "gv_mplat", "pool": ["icicles", "icerun", "pits", "crumblechain", "dashgap", "climb", "movepits"], "sig": ["icerun", "icicles", "crumblechain"], "deco": [["gvi_stone-1", 3], ["gvi_stone-2", 2], ["gvi_pillar", 1], ["gvi_pillar-broken", 2], ["gvi_statue", 1], ["gvi_tree-1", 1]], "boss": {"type": 5, "name": "BESTIA DE ESCARCHA", "hint": "Esquiva sus cargas y las estalactitas"}, "lore": "Bajo el hielo eterno, cada paso resbala. Cuidado con las estalactitas: caen cuando pasas debajo."}, {"name": "ABISMO INFERNAL", "sub": "Llamas y almas", "c": "#ff4a3a", "tiles": "T_inferno", "music": "w6", "bg": 6, "weather": "embers", "critter": null, "lavaPits": true, "g": ["nb_hellbeast", "nb_nightmare"], "a": ["nb_fireskull"], "spk": "spk_inf", "mplat": "gv_mplat", "pool": ["firejets", "lavapit", "crumblechain", "gauntlet", "shiftwall", "dashgap", "climb"], "sig": ["firejets", "crumblechain", "chase"], "deco": [["gvf_pillar", 2], ["gvf_pillar-broken", 2], ["gvf_statue", 1], ["gvf_stone-1", 2], ["d_torch", 3]], "boss": {"type": 6, "name": "DEMONIO DEL ABISMO", "hint": "Aléjate de su aliento y atácalo cuando descienda"}, "lore": "El penúltimo fragmento arde en el corazón del abismo. El Demonio que lo custodia ha devorado siglos enteros."}, {"name": "CIUDADELA DEL TIEMPO", "sub": "Gravedad cero", "c": "#ffd34d", "tiles": "T_chrono", "music": "w7", "bg": 7, "weather": "clocks", "critter": null, "g": ["shieldskel", "nb_knight"], "a": ["nb_flyeye", "nb_bat"], "spk": "spk_cyber", "mplat": "w_platform", "pool": ["lowgrav", "gears", "laserrun", "lasers", "movepits", "conveyorpit", "shiftgap"], "sig": ["gears", "laserrun", "lowgrav"], "deco": [["w_antenna", 1], ["w_control-box-1", 2], ["w_control-box-2", 2], ["w_monitorface", 2, 1]], "boss": {"type": 7, "name": "KAEL SOMBRÍO", "hint": "Tu reflejo conoce tus movimientos. Anticípate."}, "lore": "En la Ciudadela, fuera del tiempo, te espera tu propio reflejo: el Kael que eligió romper el Reloj. Solo uno puede salir de aquí."}, {"name": "ARRECIFE ABISAL", "sub": "Nado y corrientes", "c": "#3ff0d0", "tiles": "T_reef", "music": "w8", "bg": 8, "weather": "bubbles", "critter": null, "g": ["crab", "nb_meerman"], "a": ["angler", "jelly"], "spk": "spk_ice", "mplat": "gv_mplat", "pool": ["water", "current", "movepits", "pits", "crumble", "dashgap", "gauntlet"], "sig": ["water", "current", "movepits"], "deco": [["gvi_stone-1", 2], ["gvi_stone-2", 2], ["gvi_pillar-broken", 2], ["gvi_statue", 1]], "boss": {"type": 8, "name": "LEVIATÁN DE CORAL", "hint": "Cuando muerda el suelo, ¡golpea su señuelo!"}, "lore": "Un fragmento se hundió en una ciudad sumergida. Bajo el agua el tiempo fluye despacio: pulsa SALTO para nadar."}, {"name": "DESIERTO ETERNO", "sub": "Eco temporal y arenas", "c": "#ffc24a", "tiles": "T_sand", "music": "w9", "bg": 9, "weather": "sand", "critter": null, "g": ["scarab", "mummy"], "a": ["vulture"], "spk": "spk_inf", "mplat": "p_platform_v", "pool": ["quicksand", "sandfall", "echo", "dashgap", "gauntlet", "pits", "crumblechain"], "sig": ["quicksand", "echo", "dashgap"], "deco": [["p_skulls", 2], ["p_rock_v", 2], ["gvf_pillar-broken", 2], ["gvf_statue", 1]], "boss": {"type": 9, "name": "ESFINGE DEL RELOJ", "hint": "Pisa las dos placas a la vez (tú y tu ECO) para romper su escudo"}, "lore": "Arena que cae hacia el cielo y ruinas de relojes colosales. Aquí necesitarás estar en dos lugares a la vez: usa el ECO."}, {"name": "TEMPLO CELESTE", "sub": "Anclas y nubes", "c": "#bfe6ff", "tiles": "T_marble", "music": "w10", "bg": 10, "weather": "clouds", "critter": "bird", "g": ["golem"], "a": ["seraph"], "spk": "spk_ice", "mplat": "w_platform", "pool": ["anchors", "anchors2", "clouds", "anchorpit", "windpit", "updraft", "pits"], "sig": ["anchorpit", "clouds", "anchors2"], "deco": [["gvi_pillar", 2], ["gvi_statue", 1], ["gvi_pillar-broken", 2], ["gvi_stone-1", 2]], "boss": {"type": 10, "name": "SERAFÍN INVERTIDO", "hint": "Cuando el cielo se invierta, mantén la calma: tus controles no cambian"}, "lore": "Templos colgando de las nubes y cascadas que suben. Engánchate a los anillos dorados acercándote en el aire."}, {"name": "NEXO DE CHRONOS", "sub": "Todos los mundos", "c": "#ff6ad5", "tiles": "T_void", "music": "w11", "bg": 11, "weather": "void", "critter": null, "g": ["voidling", "shieldskel", "crab"], "a": ["seraph", "goldeye", "jelly"], "spk": "spk_cyber", "mplat": "w_platform", "pool": ["dashgap", "movepits", "crumblechain", "laserrun", "windpit", "anchorpit", "shiftpit", "gauntlet", "water"], "sig": ["anchorpit", "shiftpit", "chase"], "deco": [["w_antenna", 1], ["gvf_pillar-broken", 2], ["gvi_statue", 1], ["w_monitorface", 1, 1]], "boss": {"type": 11, "name": "EL DEVORADOR DE HORAS", "hint": "Cuando se agote y baje, ¡ataca su ojo!"}, "lore": "El corazón roto del tiempo. Aquí todos los mundos se mezclan. El último fragmento… y el Devorador."}, {"name": "PANTANO DE LAS BRUJAS", "sub": "Ciénagas y maleficios", "c": "#8fe36a", "tiles": "T_jungle", "music": "w12", "bg": 12, "weather": "fog", "critter": "crow", "g": ["nb_toad", "mushroom", "nb_thing"], "a": ["nb_swghost", "eye"], "spk": "spk_jungle", "mplat": "gv_mplat", "pool": ["water", "gauntlet", "pits", "movepits", "graves", "ghosts", "crumble"], "sig": ["water", "gauntlet", "pits"], "deco": [["gv_tree-1", 2], ["gv_stone-1", 2], ["gv_bush-small", 3]], "boss": {"type": 10, "skin": "boss_witch", "name": "LA BRUJA MADRE", "hint": "Esquiva sus picados y golpéala cuando quede aturdida en el suelo"}, "lore": "Más allá de las nubes, un fragmento se pudre en el Pantano de las Brujas. La niebla susurra tu nombre… y algo en el agua responde."}, {"name": "CIUDADELA DEL REY CAÍDO", "sub": "Tronos rotos y cadenas", "c": "#8fb4ff", "tiles": "T_cemetery", "music": "w13", "bg": 13, "weather": "embers", "critter": "crow", "g": ["nb_ogre", "nb_werewolf", "gskel"], "a": ["nb_eghost", "nb_flyeye"], "spk": "spk_inf", "mplat": "gv_mplat", "pool": ["gauntlet", "shiftwall", "climb", "dashgap", "lasers", "crumblechain", "firejets"], "sig": ["gauntlet", "climb", "chase"], "deco": [["gvf_pillar", 2], ["gvf_pillar-broken", 2], ["gvf_statue", 1], ["d_torch", 2]], "boss": {"type": 8, "skin": "boss_king", "name": "EL REY CAÍDO", "hint": "Cuando clave su espada en el suelo y quede atrapado, ¡golpéalo!"}, "lore": "El último reino antes del Nexo. Su rey juró proteger el tiempo y acabó encadenado a él. Su trono vacío aún arde con fuego de almas."}, {"name": "MINAS DE CRISTAL", "sub": "Cristales y vagonetas", "c": "#c48cff", "tiles": "T_ice", "music": "w14", "bg": 14, "weather": "fireflies", "critter": null, "g": ["golem", "nb_spider"], "a": ["nb_bat"], "spk": "spk_ice", "mplat": "gv_mplat", "pool": ["conveyorpit", "conveyor", "elevator", "icicles", "climb", "crumblechain", "movepits"], "sig": ["conveyorpit", "elevator", "climb"], "deco": [["gvi_stone-1", 3], ["gvi_stone-2", 2], ["gvi_pillar-broken", 2]], "boss": {"type": 9, "skin": "boss_golemc", "sfl": 1, "name": "GÓLEM DE CRISTAL", "hint": "Pisa las dos placas a la vez (tú y tu ECO) para romper su coraza"}, "lore": "Bajo las montañas, un fragmento cayó en las Minas de Cristal y cada piedra empezó a recordar. Las vagonetas aún ruedan solas por raíles que nadie vigila."}, {"name": "BOSQUE DE HUESOS", "sub": "Osarios y espectros", "c": "#a8e0c8", "tiles": "T_cemetery", "music": "w15", "bg": 15, "weather": "fog", "critter": "crow", "g": ["nb_reaper", "nb_nightmare"], "a": ["ghost", "nb_flyeye"], "spk": "spk_cem", "mplat": "gv_mplat", "pool": ["graves", "ghosts", "gauntlet", "pits", "climb", "bouncefield", "shiftwall"], "sig": ["graves", "ghosts", "climb"], "deco": [["gv_tree-1", 2], ["gv_stone-1", 3], ["gv_stone-2", 2], ["gv_bush-small", 2]], "boss": {"type": 8, "skin": "boss_stag", "sfl": 1, "name": "CIERVO ESPECTRAL", "hint": "Cuando clave sus astas en el suelo y quede atrapado, ¡golpéalo!"}, "lore": "Un bosque cuyos árboles crecieron de los huesos de un ejército olvidado. Entre las raíces vaga un ciervo de luz pálida que perdió el camino… y la razón."}, {"name": "BIBLIOTECA PROHIBIDA", "sub": "Libros y dimensiones", "c": "#ffc070", "tiles": "T_cemetery", "music": "w16", "bg": 16, "weather": "embers", "critter": null, "g": ["nb_knight", "nb_reaper"], "a": ["ghost", "eye"], "spk": "spk_cem", "mplat": "gv_mplat", "pool": ["shiftwall", "shiftpit", "shiftgap", "climb", "gauntlet", "echo", "pits"], "sig": ["shiftpit", "climb", "shiftwall"], "deco": [["gv_statue", 1], ["gv_pillar-broken", 2], ["gv_stone-1", 2], ["d_torch", 2]], "boss": {"type": 2, "skin": "boss_archi", "name": "EL ARCHIVERO SIN ROSTRO", "hint": "Golpea las 3 palancas para romper su escudo"}, "lore": "La Biblioteca Prohibida guarda cada instante que la Orden quiso olvidar. Los libros vuelan solos y su guardián ya no recuerda su propio rostro."}, {"name": "TORRE DE LAS TORMENTAS", "sub": "Rayos y vendavales", "c": "#8fa8ff", "tiles": "T_marble", "music": "w17", "bg": 17, "weather": "rain", "critter": null, "g": ["golem"], "a": ["seraph", "nb_flyeye"], "spk": "spk_ice", "mplat": "w_platform", "pool": ["gust", "windpit", "anchors", "anchorpit", "updraft", "climb", "dashgap"], "sig": ["windpit", "anchorpit", "chase"], "deco": [["gvi_pillar", 2], ["gvi_statue", 1], ["gvi_pillar-broken", 2], ["gvi_stone-1", 2]], "boss": {"type": 10, "skin": "boss_dragon", "sfl": 1, "name": "DRAGÓN DE LA TORMENTA", "hint": "Esquiva sus picados y golpéalo cuando quede aturdido en el suelo"}, "lore": "La última torre antes del reino caído se alza en el ojo de una tormenta eterna. Allí arriba, un dragón ruge con la voz del trueno."}], "enemy": {"opossum": {"b": "walker", "anim": "opossum", "w": 32, "h": 22, "hp": 2, "face": -1, "spd": 70, "death": "poof"}, "frog": {"b": "jumper", "anim": "frog_idle", "jump": "frog_jump", "w": 28, "h": 24, "hp": 2, "face": -1, "death": "poof"}, "eagle": {"b": "flyer", "anim": "eagle", "w": 30, "h": 30, "hp": 1, "face": -1, "shot": "orb", "death": "poof"}, "turret": {"b": "shooter", "anim": "turret", "w": 24, "h": 22, "hp": 2